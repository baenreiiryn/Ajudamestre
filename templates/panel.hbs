<section class="am-panel">
  <header class="am-header"><div><strong>Seu assistente de mesa</strong><small>{{#if account}}{{account}}{{else}}Exclusivo do mestre{{/if}}</small></div><button type="button" data-action="settings" title="Conexão e permissões"><i class="fas fa-sliders"></i> Configurar</button></header>
  <nav class="am-toolbar" aria-label="Ações do assistente"><button type="button" data-action="refresh">Atualizar conexão</button><button type="button" data-action="history">Histórico</button><button type="button" data-action="clear" {{#if busy}}disabled{{/if}}>Nova conversa</button></nav>
  {{#if target}}<aside class="am-target" aria-label="Alvo selecionado"><i class="fas fa-crosshairs" aria-hidden="true"></i><div><small>Alvo selecionado · {{target.documentName}}</small><strong>{{target.name}}</strong><small>{{#if target.uuid}}{{target.uuid}}{{else}}{{target.pack}}{{/if}}</small></div><button type="button" data-action="clear-target" title="Remover alvo e voltar à conversa geral" {{#if busy}}disabled{{/if}}><i class="fas fa-times" aria-hidden="true"></i><span class="am-sr-only">Remover alvo</span></button></aside>{{/if}}
  <div class="am-status" role="status">{{status}}</div>
  <div class="am-messages" role="log" aria-label="Conversa privada com o assistente">
    {{#unless messages.length}}<div class="am-empty"><i class="fas fa-hat-wizard"></i><h2>O mundo, ao seu comando</h2><p>Crie NPCs, organize cenas, traduza compêndios e prepare macros.</p><p>Exemplo: “Liste os compêndios de itens e traduza o de armas para português.”</p><small>O assistente consulta os dados conforme a tarefa e respeita suas permissões.</small></div>{{/unless}}
    {{#each messages}}<article class="am-message am-{{role}}"><strong>{{label}}</strong>{{#if targetName}}<small class="am-message-target">Alvo: {{targetName}}</small>{{/if}}<div>{{text}}</div></article>{{/each}}
  </div>
  <form class="am-composer"><label for="am-prompt">O que vamos preparar?</label><textarea id="am-prompt" rows="3" placeholder="Descreva a tarefa…" {{#if busy}}disabled{{/if}}></textarea><div><small>{{model}} · Enter envia · Shift+Enter quebra linha</small>{{#if busy}}<button type="button" data-action="stop">Interromper</button><button type="submit" disabled>Executando…</button>{{else}}<button type="button" data-action="stop" hidden>Interromper</button><button type="submit">Enviar <i class="fas fa-arrow-up"></i></button>{{/if}}</div></form>
</section>
